{% include '_template/header.html.twig' with {
	title: 'Carte | ParcourSUPPORT',
	project_name: project_name | default('ParcourSUPPORT'),
	additional_css: 'carte.css'
} %}

<div class="carte-layout">

	{# ── PANNEAU GAUCHE : Filtres + Légende ── #}
	<aside class="carte-sidebar">

		<div class="carte-sidebar-block">
			<p class="sidebar-label">Année scolaire</p>
			<select id="annee-select" class="filter-select">
				<option value="">— Choisir —</option>
			</select>
		</div>

		<div class="carte-sidebar-block">
			<p class="sidebar-label">Recherche groupe</p>
			<div class="search-wrapper">
				<input type="text" id="carte-search" placeholder="Rechercher un groupe..." class="carte-search-input">
				<span class="search-icon">🔍</span>
			</div>
		</div>

		<div class="carte-sidebar-block" id="legende-block" style="display:none;">
			<p class="sidebar-label">Légende</p>
			<div id="legende-container"></div>
		</div>

		<div class="carte-sidebar-block" id="stats-block" style="display:none;">
			<p class="sidebar-label">Statistiques</p>
			<div id="stats-container"></div>
		</div>

	</aside>

	{# ── ZONE PRINCIPALE : Carte + Tableau ── #}
	<div class="carte-main">

		{# Barre de sélection des groupes (checkboxes) #}
		<div class="carte-filter-bar" id="filter-bar" style="display:none;">
			<span class="filter-bar-label">Afficher :</span>
			<div id="filter-checkboxes"></div>
			<button class="btn-outline btn-sm" id="btn-tout-cocher">Tout</button>
			<button class="btn-outline btn-sm" id="btn-tout-decocher">Aucun</button>
		</div>

		{# Carte Leaflet #}
		<div id="carte-leaflet"></div>

	</div>
</div>

{# Overlay chargement #}
<div id="carte-loading" style="display:none;">
	<div class="loading-box">
		<div class="spinner"></div>
		<p id="loading-msg">Chargement de la carte...</p>
	</div>
</div>

<script>
	const menuItems = document.querySelectorAll('.menu-item');
	if (menuItems[1]) menuItems[1].classList.add('active');
	menuItems.forEach(item => {
		item.addEventListener('click', () => {
			menuItems.forEach(i => i.classList.remove('active'));
			item.classList.add('active');
			window.location.href = item.getAttribute('href');
		});
	});
</script>

{# Leaflet CSS + JS #}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/js/carte_nominatim.js"></script>

{% include '_template/footer.html.twig' %}

{% include '_template/header.html.twig' with {
	title: title | default('MonProjet'),
	project_name: project_name | default('ParcourSUPPORT'),
	additional_css: 'gestionnaire.css'
} %}
	<div class="ligne">
		{# ZONE Information #}
		<div class="card">
			<div class="card-header">
				Information
				<div class="dots-group">
					<div class="dot-header"></div>
					<div class="dot-header red"></div>
					<div class="dot-header"></div>
				</div>
			</div>
			<div class="ligne">
				<div class="stat-item">
					<h2 id="dossier-count"></h2>
				</div>
			</div>
		</div>

		{# ZONE Option #}
		<div class="card">
			<div class="card-header">
				Options
				<div class="dots-group">
					<div class="dot-header"></div>
					<div class="dot-header red"></div>
					<div class="dot-header"></div>
				</div>
			</div>
			<div class="stat-item" >
				<select id="annee-select" name="annee">
					{% for annee in annees %}
						<option value="{{ annee.value }}">{{ annee.text }}</option>
					{% endfor %}
				</select>
			</div>
			<div class="btn-group" >
				<button class="btn btn-primary"   id="import-btn">Importer un fichier</button>
				<button class="btn btn-secondary" id="delete-btn">Supprimer</button>
			</div>
		</div>
	</div>

	<section class="page-body" id="zone-fichier">
		{# ZONE Fichier #}
		<div class="card card-import">
			<div class="card-header">
				Importer un fichier
				<div class="dots-group">
					<div class="dot-header"></div>
					<div class="dot-header red"></div>
					<div class="dot-header"></div>
				</div>
			</div>
			
			<div class="card-body">
				<label for="file-input" class="import-area" id="drop-zone">
					<div class="import-icon">📥</div>
					<p class="import-text">
						<strong>Glissez-déposez</strong> votre fichier ici <br>
						<span>ou cliquez pour sélectionner</span>
					</p>
					<input type="file" id="file-input" name="file" hidden>
					<div id="file-name" class="file-return"></div>
				</label>
			</div>
		</div>
	</section>


	{# ZONE DE TRAVAIL (Tableaux, Cartes) #}
	<section class="page-body" id="zone-tableau">
		<div class="hero-sub">Tableau</div>
		
		{# Exemple de contenu #}
		<div class="content-placeholder" style="overflow-x: auto; max-height: 500px; overflow-y: auto;">
			<table class="table table-striped" id="excel-table"></table>
		</div>
		
		<!-- PAGINATION -->
		<div class="pagination-bar" id="paginationBar">
			
		</div>

		<div id ="confirm-btn-container">
			
		</div>
	</section>


	<section class="page-body" id="zone-liste-fichiers" style="display:none;">
		<div class="hero-sub">
			Liste des fichiers
			<div class="dots-group">
				<button class="btn btn-secondary" id="delete-all-btn">Supprimer_tous</button>
			</div>
		</div>
		<div class="content-placeholder" id="liste-fichiers-container">
			<!-- Les fichiers seront affichés ici -->
		</div>
	</section>


	<!-- Fenêtre de chargement -->
	<div id="loading-overlay" style="display:none;">
		<div class="loading-box">
			<div class="spinner"></div>
			<p id="traitement"></p>
		</div>
	</div>

<script src="https://cdn.sheetjs.com/xlsx-0.20.0/package/dist/xlsx.full.min.js"></script>

<script>
	const initialFichiers = {{ fichiers|json_encode|raw }};
</script>
<script src="/js/gestionnaire.js"></script>
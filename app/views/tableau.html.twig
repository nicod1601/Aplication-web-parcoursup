{% include '_template/header.html.twig' with {
	title: 'Tableau | ParcourSUPPORT',
	project_name: project_name | default('ParcourSUPPORT'),
	additional_css: 'tableau.css',
	recherche_active: true
} %}

	<div class="ligne">
		{# ZONE Diplome #}
		<div class="card-lg">
			<div class="card-header">
				DIPLÔME
				<div class="dots-group">
					<div class="dot-header"></div>
					<div class="dot-header red"></div>
					<div class="dot-header"></div>
				</div>
			</div>
			<div id='card-diplome' class="ligne">
				{# ZONE Diplôme #}
				<div class="stat-item">
					<h2>-</h2>
					<p>-</p>
				</div>
				<div class="stat-item">
					<h2>-</h2>
					<p>-</p>
				</div>
				<div class="stat-item">
					<h2>-</h2>
					<p>-</p>
				</div>
				<div class="stat-item">
					<h2>-</h2>
					<p>-</p>
				</div>
			</div>
		</div>

		{# ZONE Annee #}
		<div class="card">
			<div class="card-header">
				ANNÉE
				<div class="dots-group">
					<div class="dot-header"></div>
					<div class="dot-header red"></div>
					<div class="dot-header"></div>
				</div>
			</div>
			<div class="stat-item" >
				<select name="annee" id="annee-select" class="custom-select">
						<option selected>Pas de promotion importée</option>
				</select>

				<button type="submit" id="btnAnnee" class="btn btn-primary" disabled>Valider</button>
			</div>
		</div>
	</div>

	<div class="ligne">
		{# ZONE Nombre total #}
		<div class="card">
			<div class="card-header">
				NOMBRE TOTAL
				<div class="dots-group">
					<div class="dot-header"></div>
					<div class="dot-header red"></div>
					<div class="dot-header"></div>
				</div>			
			</div>
			<div id="card-total" class="ligne">
				<div class="stat-item" style="text-align:center; padding: 20px;">
					<h2 id="nbCandTotal">-</h2>
					<p>Nombre total</p>
				</div>
			</div>
		</div>

		{# ZONE Genre #}
		<div class="card-lg">
			<div class="card-header">
				GENRE
				<div class="dots-group">
					<div class="dot-header"></div>
					<div class="dot-header red"></div>
					<div class="dot-header"></div>
				</div>
			</div>
			<div id="card-genre" class="ligne">
				<div class="stat-item">
					<h2>-</h2>
					<p>-</p>
				</div>
				<div class="stat-item">
					<h2>-</h2>
					<p>-</p>
				</div>
				<div class="stat-item">
					<h2>-</h2>
					<p>-</p>
				</div>
			</div>
		</div>
	</div>


	{# ZONE DE TRAVAIL (Tableaux, Cartes) #}
	<section class="page-body">
		<div class="hero-sub">
			<span>TABLEAU</span>
			<div class="btn-group-right">
				<button id="btnFiltrer" class="btn btn-secondary mb-3" disabled>Filtrer</button>
				<button id="btnGrouper" class="btn btn-secondary mb-3" disabled>Grouper</button>
				<button id="btnExporter" class="btn btn-primary mb-3" disabled>Exporter en CSV</button>
			</div>
		</div>

		{# Exemple de contenu #}
		<div class="content-placeholder">
			<table id='tableau-candidats' class="table table-striped">
				<thead id="tableau-head">
				<td>Code du candidat</td>
				<td>Civilité du candidat</td>
				<td>Profil du candidat</td>
				<td>Nom de l'établissement</td>
				<td>Commune</td>
				<td>Département</td>
				<td>Pays</td>
				<td>Code de la série du diplôme</td>
				<td>Nom complet de la série du diplôme</td>
				<td>Spécialité du diplôme</td>
				<td>Combinaison des enseignements de spécialité en terminale</td>
				<td>Enseignement de spécialité abandonné en première</td>
				<td>Note Globale</td>
				<td>Note Ficher Avenir</td>
				<td>Note Lycée</td>
				<td>Note de dossier</td>
				<td>Commentaire</td>
				</thead>
				<tbody id="tableau-data">
				<tr>
					<td colspan="100" style="text-align:center; padding: 30px; color: gray; font-style: italic;">
						📭 Aucune donnée à afficher — importez un fichier Excel
					</td>
				</tr>
				</tbody>
			</table>
		</div>

		<div class="pagination-bar" id="paginationBar"></div>
	</section>

	{# Carte erreur — juste avant les boutons #}
	{% if errors is defined and errors is not empty %}
		<div class="card-error">
			<div class="card-error-header">
				<span class="error-icon">✕</span>
				{{ errors|length }}
				{% if errors|length > 1 %}
					Erreurs détectées
				{% else %}
					Erreur détectée
				{% endif %}
			</div>
			<ul class="error-list">
				{% for error in errors %}
					<li>{{ error }}</li>
				{% endfor %}
			</ul>
		</div>
	{% endif %}
</main>
</div>
<script>
	const menuItems = document.querySelectorAll('.menu-item');
	menuItems[2].classList.add('active');

	menuItems.forEach(item => {
		item.addEventListener('click', () => {
			menuItems.forEach(i => i.classList.remove('active'));
			item.classList.add('active');

			const page = item.getAttribute('href').substring(0);
			window.location.href = `../../public/${page}`;

		});
	});
</script>

<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>
<script src="/js/tableau.js"></script>

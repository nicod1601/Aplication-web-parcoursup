{% include '_template/header.html.twig' with {
	title: title | default('MonProjet'),
	project_name: project_name | default('ParcourSUPPORT'),
	additional_css: 'filtrer.css'
} %}
		<div class="ligne">
			<div class="card-lg">
				<div class="card-header">
					Filtrer
					<div class="dots-group">
						<div class="dot-header"></div>
						<div class="dot-header red"></div>
						<div class="dot-header"></div>
					</div>
				</div>

				<div class="card-body-filter">
					<form method="post">
						{# — Ligne 1 : Bac / Notes / Civilité — #}
						<div class="filter-row">
							{# Bloc Bac #}
							<div id="cardBac" class="filter-group">
								<h4>Baccalauréat</h4>
								<div class="filter-field">
									<label class="filter-label">Type de Bac :</label>
									<select id="typeBac-select" name="typeBac" class="filter-select">

									</select>
								</div>
							</div>

							{# Bloc Notes (sliders) #}
							<div id="cardNote" class="filter-group">
								<h4>Notes</h4>
								<div class="filter-field">
									<label class="filter-label">Note globale :</label>
									<span class="filter-range-val">0</span>
									<div class="filter-range-wrap">
										<input name="noteGlobaleMin" type="range" min="0" max="20" value="0"  id="noteGlobale-min">
										<input name="noteGlobaleMax" type="range" min="0" max="20" value="20" id="noteGlobale-max">
									</div>
									<span class="filter-range-val">20</span>
								</div>
								<div class="filter-field" style="margin-top: 0.6rem;">
									<label class="filter-label">Note Fiche Avenir :</label>
									<span class="filter-range-val">0</span>
									<div class="filter-range-wrap">
										<input name="noteFicheAvenirMin" type="range" min="0" max="20" value="0"  id="noteFicheAvenir-min">
										<input name="noteFicheAvenirMax" type="range" min="0" max="20" value="20" id="noteFicheAvenir-max">
									</div>
									<span class="filter-range-val">20</span>
								</div>
							</div>

							{# Bloc Civilité / Bourse #}
							<div id="cardCivilite" class="filter-group">
								<h4>Civilité</h4>
								<div class="filter-field">
									<label class="filter-label">Civilité :</label>
									<select name="civilite" id="civilite-select" class="filter-select">

									</select>
								</div>
								<div class="filter-field">
									<label class="filter-label">Niveau de bourse :</label>
									<select  name="niveauBourse" id="bourse-select" class="filter-select">

									</select>
								</div>
							</div>
						</div>

						<div class="filter-row" style="padding-top: 1.5rem">
							<div id="cardEtablissement" class="filter-group">
								<h4>Établissement</h4>
								<div class="filter-field">
									<label class="filter-label">Établissement :</label>
									<select name="etablissement" id="etablissement-select" class="filter-select">

									</select>
								</div>
								<div class="filter-field">
									<label class="filter-label">Commune :</label>
									<select name="commune" id="commune-select" class="filter-select">

									</select>
								</div>
								<div class="filter-field">
									<label class="filter-label">Département :</label>
									<select name="departement" id="departement-select" class="filter-select">

									</select>
								</div>
								<div class="filter-field">
									<label class="filter-label">Pays :</label>
									<select name="pays" id="pays-select" class="filter-select">

									</select>
								</div>
							</div>
						</div>

						{# Carte erreur — juste avant les boutons #}
						{% if errors is defined and errors is not empty %}
							<div class="card-error">
								<div class="card-error-header">
									<span class="error-icon">✕</span>
									{{ errors|length }}
									{% if errors|length > 1 %}
										 Erreurs détectées
									{% else %}
										 Erreur détectée
									{% endif %}
								</div>
								<ul class="error-list">
									{% for error in errors %}
										<li>{{ error }}</li>
									{% endfor %}
								</ul>
							</div>
						{% endif %}

						{# — Boutons — #}
						<div class="filter-actions">
							<button type="button" id="btnAnnuler"   class="btn btn-primary">✕ Annuler</button>
							<button type="button" id="btnConfirmer" class="btn btn-primary">✔ Confirmer</button>
						</div>
					</form>
				</div>
			</div>
		</div>


<script src="/js/filtrer.js"></script>
<script>
	const menuItems = document.querySelectorAll('.menu-item');
	menuItems[2].classList.add('active');

	menuItems.forEach(item => {
		item.addEventListener('click', () => {
			menuItems.forEach(i => i.classList.remove('active'));
			item.classList.add('active');

			const page = item.getAttribute('href').substring(0);
			window.location.href = `../../public/${page}`;

		});
	});
</script>

{% include '_template/footer.html.twig' %}

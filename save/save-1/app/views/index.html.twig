{% include '_template/header.html.twig' with {
	title: title | default('MonProjet'),
	project_name: project_name | default('MonProjet'),
	additional_css: 'index.css'
} %}
	<div class="welcome-banner">
		<div class="welcome-content">
			<h1>Bienvenue {{ userName | default('Olivier') }}</h1>
			<p>Bienvenue sur MonProjet — plateforme de gestion et de visualisation des candidatures.</p>
		</div>
	</div>

	<section>
		<p class="section-label">Accès rapides</p>
		<div class="ligne">

			<a href="carte.php" class="card" style="text-decoration:none;">
				<div class="card-header">
					Carte
					<div class="dots-group">
						<div class="dot-header"></div>
						<div class="dot-header red"></div>
						<div class="dot-header"></div>
					</div>
				</div>
				<div class="card-body">
					<span class="card-icon">🗺️</span>
					<span class="card-sub">Visualisation Map</span>
				</div>
			</a>

			<a href="tableau.php" class="card" style="text-decoration:none;">
				<div class="card-header">
					Table
					<div class="dots-group">
						<div class="dot-header"></div>
						<div class="dot-header red"></div>
						<div class="dot-header"></div>
					</div>
				</div>
				<div class="card-body">
					<span class="card-icon">📋</span>
					<span class="card-sub">Liste des dossiers</span>
				</div>
			</a>

			<a href="gestionnaire.php" class="card" style="text-decoration:none;">
				<div class="card-header">
					Gestionnaire
					<div class="dots-group">
						<div class="dot-header"></div>
						<div class="dot-header red"></div>
						<div class="dot-header"></div>
					</div>
				</div>
				<div class="card-body">
					<span class="card-icon">📁</span>
					<span class="card-sub">Gestion des données</span>
				</div>
			</a>

			<a href="creation.php" class="card" style="text-decoration:none;">
				<div class="card-header">
					Création Compte
					<div class="dots-group">
						<div class="dot-header"></div>
						<div class="dot-header red"></div>
						<div class="dot-header"></div>
					</div>
				</div>
				<div class="card-body">
					<span class="card-icon">👤</span>
					<span class="card-sub">Nouvel utilisateur</span>
				</div>
			</a>

		</div>
	</section>

	<section>
		<p class="section-label">Notifications récentes</p>
		<div class="notifs">
			{% if notifications is defined and notifications is not empty %}
				{% for notif in notifications %}
					<div class="notif-card">
						<div class="notif-dot {{ notif.type }}"></div>
						<div class="notif-body">
							<p>{{ notif.message }}</p>
							<span>{{ notif.date }}</span>
						</div>
						<span class="notif-badge {{ notif.type }}">
							{% if notif.type == 'urgent' %}Urgent
							{% elseif notif.type == 'info' %}Info
							{% elseif notif.type == 'success' %}Succès
							{% endif %}
						</span>
					</div>
				{% endfor %}
			{% else %}
				<div class="notif-card">
					<div class="notif-dot info"></div>
					<div class="notif-body">
						<p>Aucune notification pour le moment.</p>
						<span>—</span>
					</div>
				</div>
			{% endif %}
		</div>
	</section>

</div>

{% include '_template/footer.html.twig' %}

<script>
	const menuItems = document.querySelectorAll('.menu-item');
	const cardLinks = document.querySelectorAll('.card');


	if (menuItems.length > 0) {
		menuItems[0].classList.add('active');
	}

	menuItems.forEach(item => {
		item.addEventListener('click', (e) => {
			e.preventDefault();
			menuItems.forEach(i => i.classList.remove('active'));
			item.classList.add('active');

			const page = item.getAttribute('href');
			window.location.href = page;
		});
	});

	cardLinks.forEach(item => {
		item.addEventListener('click', (e) => {
			e.preventDefault();
			menuItems.forEach(i => i.classList.remove('active'));
			item.classList.add('active');

			const page = item.getAttribute('href');
			window.location.href = page;
		});
	});
</script>
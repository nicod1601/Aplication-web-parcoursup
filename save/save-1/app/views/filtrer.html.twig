<!DOCTYPE html>
<html lang="fr">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ title | default('MonProjet') }}</title>
	<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/css/filtrer.css" rel="stylesheet">
	<link href="/css/app.css" rel="stylesheet">
</head>
	<body>
		<div class="ligne">
			<div class="card-lg">
				<div class="card-header">
					Filtrer
					<div class="dots-group">
						<div class="dot-header"></div>
						<div class="dot-header red"></div>
						<div class="dot-header"></div>
					</div>
				</div>

				<div class="card-body-filter">
					{# — Ligne 1 : Bac / Notes / Civilité — #}
					<div class="filter-row">
						{# Bloc Bac #}
						<div class="filter-group">
							<h4>Baccalauréat</h4>
							<div class="filter-field">
								<label class="filter-label">Type de Bac :</label>
								<select class="filter-select">
									{# <option>NSI / Maths<option> #}
								</select>
							</div>
							<div class="filter-field">
								<label class="filter-label">Spécialités de terminale :</label>
								<select class="filter-select">
									{# <option>NSI / Maths<option> #}
								</select>
							</div>
							<div class="filter-field">
								<label class="filter-label">Spécialité abandonnée en première :</label>
								<select class="filter-select">
									{# <option>SI</option> #}
								</select>
							</div>
						</div>

						{# Bloc Notes (sliders) #}
						<div class="filter-group">
							<h4>Notes</h4>
							<div class="filter-field">
								<label class="filter-label">Note globale :</label>
								<span class="filter-range-val">0</span>
								<div class="filter-range-wrap">
										<input type="range" min="0" max="20" value="13" id="slider-1" oninput="slideOne()">
										<input type="range" min="0" max="20" value="18" id="slider-2" oninput="slideTwo()">
								</div>
								<span class="filter-range-val">20</span>
							</div>
							<div class="filter-field" style="margin-top: 0.6rem;">
								<label class="filter-label">Note Fiche Avenir :</label>
								<span class="filter-range-val">0</span>
								<div class="filter-range-wrap">
										<input type="range" min="0" max="20" value="13" id="slider-1" oninput="slideOne()">
										<input type="range" min="0" max="20" value="18" id="slider-2" oninput="slideTwo()">
								</div>
								<span class="filter-range-val">20</span>
							</div>
						</div>

						{# Bloc Civilité / Bourse #}
						<div class="filter-group">
							<h4>Civilité</h4>
							<div class="filter-field">
								<label class="filter-label">Civilité :</label>
								<select class="filter-select">
									<option>Mme</option>
									<option>M.</option>
								</select>
							</div>
							<div class="filter-field">
								<label class="filter-label">Bourse :</label>
								<select class="filter-select">
									<option>Non</option>
									<option>Oui</option>
								</select>
							</div>
						</div>
					</div>

					{# — Ligne 2 : Commune / Département / Pays — #}
					<div class="filter-row">
						<div class="filter-group">
							<h4>Établissement</h4>
							<div class="filter-field">
								<label class="filter-label">Établissement :</label>
								<select class="filter-select">
									{# <option>Le Havre</option> #}
								</select>
							</div>
							<div class="filter-field">
								<label class="filter-label">Commune :</label>
								<select class="filter-select">
									{# <option>Le Havre</option> #}
								</select>
							</div>
							<div class="filter-field">
								<label class="filter-label">Département :</label>
								<select class="filter-select">
									{# <option>Seine-Maritime</option> #}
								</select>
							</div>
							<div class="filter-field">
								<label class="filter-label">Pays :</label>
								<select class="filter-select">
									{# <option>La France</option> #}
								</select>
							</div>
						</div>
					</div>

					{# — Boutons — #}
					<div class="filter-actions">
						<button class="btn btn-primary">✕ Annuler</button>
						<button class="btn btn-primary">✔ Confirmer</button>
					</div>
				</div>
			</div>
		</div>
	</body>
</html>
{% include '_template/header.html.twig' with {
	title: 'Création de compte',
	project_name: project_name | default('MonProjet'),
	additional_css: 'creation.css'
} %}


<div class="page-body">
	<!-- Section Création de compte -->
	<div class="card-lg" style="margin-bottom: 2rem;">
		<div class="card-header">
			Création de compte
			<div class="dots-group">
				<span class="dot-header"></span>
				<span class="dot-header"></span>
				<span class="dot-header red"></span>
			</div>
		</div>
		<div class="card-body-filter">
			<form id="createAccountForm" method="post">
				<div class="filter-row">
					<div class="filter-group">
						<div class="filter-field">
							<label class="filter-label">Nom</label>
							<input type="text" name="nom" class="filter-select" placeholder="Roualet" required>
						</div>
						<div class="filter-field">
							<label class="filter-label">Prénom</label>
							<input type="text" name="prenom" class="filter-select" placeholder="Jean" required>
						</div>
					</div>
					<div class="filter-group">
						<div class="filter-field">
							<label class="filter-label">Email</label>
							<input type="email" name="email" class="filter-select" placeholder="olivia@orillnbcki.com" required>
						</div>
						<div class="filter-field">
							<label class="filter-label">Mot de passe</label>
							<div style="position: relative; flex: 1;">
								<input type="password" name="mot_de_passe" class="filter-select" placeholder="••••" required>
								<button type="button" class="btn-password-generate">
									Générer mot de passe
								</button>
							</div>
						</div>
					</div>
				</div>
				<div class="filter-actions">
					<button type="button" class="btn-outline">✖ Annuler</button>
					<button type="button" id="btnAddRow" class="btn-primary">✔ Confirmer</button>
				</div>
			</form>
		</div>
	</div>

	<!-- Section Les comptes -->
	<div class="card-lg">
		<div class="card-header">
			Les comptes
			<div class="dots-group">
				<span class="dot-header"></span>
				<span class="dot-header"></span>
				<span class="dot-header red"></span>
			</div>
		</div>
		<div class="table-container">
			<!-- Tabs -->
			<div class="tabs-container">
				<button class="tab-button active" data-tab="parcourir">Tableau des comptes</button>
			</div>

			<!-- Table -->
			<table class="accounts-table" id="accountsTable">
				<thead>
				<tr>
					<th>Nom</th>
					<th>Prénom</th>
					<th>Email</th>
					<th>Mot de Passe (Haché/Masqué)</th>
					<th>Admin</th>
					<th>Action</th>
				</tr>
				</thead>
				<tbody id="tableBody">
				</tbody>
			</table>

			<!-- Pagination -->
			<div class="pagination-wrapper">
				<button class="btn-outline">⟵ Previous</button>
				<button class="btn-outline page-number active">1</button>
				<button class="btn-outline page-number">2</button>
				<button class="btn-outline page-number">3</button>
				<span class="pagination-ellipsis">...</span>
				<button class="btn-outline page-number">8</button>
				<button class="btn-outline page-number">9</button>
				<button class="btn-outline page-number">10</button>
				<button class="btn-outline">Next ⟶</button>
			</div>

			<!-- Enregistrer button -->
			<div class="action-button-center">
				<button type="button" id="btnSaveToDb" class="btn-primary">
					Enregistrer dans la base de données
				</button>
			</div>
		</div>
	</div>
</div>

<script src="/js/creation.js"></script>

{% include '_template/footer.html.twig' %}